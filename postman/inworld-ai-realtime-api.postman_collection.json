                      "raw": "{\n  \"sdp\": \"<string>\",\n  \"sessionConfig\": {\n    \"model\": \"<string>\",\n    \"instructions\": \"<string>\",\n    \"temperature\": \"<number>\",\n    \"maxTokens\": \"<integer>\",\n    \"voice\": \"<string>\",\n    \"inputAudioFormat\": \"pcmu\",\n    \"outputAudioFormat\": \"pcma\",\n    \"turnDetection\": {\n      \"type\": \"server_vad\",\n      \"threshold\": \"<number>\",\n      \"silenceDurationMs\": \"<integer>\"\n    },\n    \"toolChoice\": \"<string>\",\n    \"mcpServers\": [\n      {\n        \"url\": \"<string>\",\n        \"transport\": \"<string>\"\n      },\n      {\n        \"url\": \"<string>\",\n        \"transport\": \"<string>\"\n      }\n    ]\n  }\n}",
