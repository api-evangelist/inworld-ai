          "id": "eed87535-d297-429b-bfdf-c6664e6af70f",
          "name": "Transcribe Audio",
          "request": {
            "name": "Transcribe Audio",
            "description": {
              "content": "Transcribe a base64-encoded audio payload to text. Optionally returns word timestamps and routes through the requested provider/model id.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "stt",
                "v1",
                "transcribe"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transcribeConfig\": {\n    \"modelId\": \"<string>\",\n    \"audioEncoding\": \"<string>\",\n    \"language\": \"<string>\",\n    \"sampleRateHertz\": 16000,\n    \"numberOfChannels\": 1,\n    \"inactivityTimeoutSeconds\": \"<integer>\",\n    \"endOfTurnConfidenceThreshold\": 0.5,\n    \"prompts\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"includeWordTimestamps\": \"<boolean>\",\n    \"voiceProfileConfig\": {\n      \"enabled\": \"<boolean>\",\n      \"profileId\": \"<string>\"\n    }\n  },\n  \"audioData\": {\n    \"content\": \"<byte>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
