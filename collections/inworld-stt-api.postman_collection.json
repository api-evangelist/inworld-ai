  "info": {
    "_postman_id": "c94bf849-64c1-4304-b034-c29c94855152",
    "name": "Inworld STT API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Inworld Speech-to-Text. Synchronous transcription and a streaming WebSocket endpoint. Multi-provider routing (provider/model id, e.g. `groq/whisper-large-v3`), 99+ languages, word timestamps, contextual prompts, end-of-turn detection, and voice-profile-aware transcription for conversational agents.\n\n\nContact Support:\n Name: Inworld Support",
      "type": "text/plain"
    }
  }
