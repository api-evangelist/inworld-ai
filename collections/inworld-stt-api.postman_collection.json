        {
          "id": "4f2576fa-3608-400c-99b6-89b4948277e9",
          "name": "Streaming Transcribe (WebSocket)",
          "request": {
            "name": "Streaming Transcribe (WebSocket)",
            "description": {
              "content": "Upgrade to a WebSocket. Send PCM/Opus audio chunks and receive interim and final transcripts with word timestamps. Auth via `Authorization: Basic` on the upgrade.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "stt",
                "v1",
                "transcribe:stream"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "method": "GET",
            "auth": null
          },
