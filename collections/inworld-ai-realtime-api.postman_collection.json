        {
          "id": "7dd20c32-3224-4df0-8c72-5743c5a08252",
          "name": "Realtime WebRTC Offer Exchange",
          "request": {
            "name": "Realtime WebRTC Offer Exchange",
            "description": {
              "content": "Exchange a WebRTC SDP offer for an answer to open a realtime audio session. The server provisions an audio track wired to the same STT-LLM-TTS pipeline used by the WebSocket endpoint.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "realtime",
                "webrtc"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sdp\": \"<string>\",\n  \"sessionConfig\": {\n    \"model\": \"<string>\",\n    \"instructions\": \"<string>\",\n    \"temperature\": \"<number>\",\n    \"maxTokens\": \"<integer>\",\n    \"voice\": \"<string>\",\n    \"inputAudioFormat\": \"<string>\",\n    \"outputAudioFormat\": \"<string>\",\n    \"turnDetection\": {\n      \"type\": \"<string>\",\n      \"threshold\": \"<number>\",\n      \"silenceDurationMs\": \"<integer>\"\n    },\n    \"tools\": [\n      \"<object>\",\n      \"<object>\"\n    ],\n    \"toolChoice\": \"<string>\",\n    \"mcpServers\": [\n      {\n        \"url\": \"<string>\",\n        \"transport\": \"<string>\"\n      },\n      {\n        \"url\": \"<string>\",\n        \"transport\": \"<string>\"\n      }\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
